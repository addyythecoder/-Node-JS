<%- include('../header')%>

<style>
    /* UI Customizations */
    .page-wrapper {
        background-color: #f5f7fb;
        min-height: 100vh;
    }

    .custom-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        background: #fff;
        margin-top: 20px;
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 25px;
        border-bottom: 1px solid #f0f2f5;
    }

    .table-container {
        padding: 0 15px 15px 15px;
    }

    /* Table Styling */
    .custom-table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0 8px; /* Adds space between rows */
    }

    .custom-table thead th {
        background-color: transparent;
        border: none;
        color: #95aac9;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 15px;
    }

    .custom-table tbody tr {
        transition: all 0.2s;
    }

    .custom-table tbody tr:hover {
        background-color: #f9fbfd !important;
        transform: translateY(-1px);
    }

    .custom-table td {
        background: #fff;
        border-top: 1px solid #edf2f9;
        border-bottom: 1px solid #edf2f9;
        padding: 15px;
        vertical-align: middle;
        color: #506690;
        font-size: 0.9rem;
    }

    /* Round the corners of rows */
    .custom-table td:first-child { border-left: 1px solid #edf2f9; border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .custom-table td:last-child { border-right: 1px solid #edf2f9; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }

    /* Category Badge */
    .cat-badge {
        background: #e3ebf6;
        color: #2c7be5;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Image Styling */
    .img-container {
        width: 45px;
        height: 45px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #eee;
    }

    .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Action Buttons */
    .btn-action {
        width: 32px;
        height: 32px;
        line-height: 32px;
        padding: 0;
        border-radius: 50%;
        text-align: center;
        transition: 0.3s;
        border: none;
    }

    .btn-edit { background-color: rgba(44, 123, 229, 0.1); color: #2c7be5; }
    .btn-edit:hover { background-color: #2c7be5; color: #fff; }

    .btn-delete { background-color: rgba(230, 55, 87, 0.1); color: #e63757; }
    .btn-delete:hover { background-color: #e63757; color: #fff; }

</style>

<div class="page-wrapper">
    <div class="page-breadcrumb">
        <div class="row">
            <div class="col-12 d-flex no-block align-items-center">
                <h4 class="page-title" style="font-weight: 700; color: #12263f;">Sub-Category Management</h4>
                <div class="ml-auto text-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="background: transparent;">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Sub-Categories</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card custom-card">
                    <div class="card-header-flex">
                        <h5 class="mb-0" style="color: #12263f;">Registered Sub-Categories</h5>
                        <div class="search-box">
                            <input type="text" class="form-control form-control-sm" placeholder="Search sub-categories..." style="border-radius: 20px; padding: 5px 15px; border: 1px solid #dcdfe6;">
                        </div>
                    </div>

                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table custom-table">
                                <thead>
                                    <tr>
                                        <th style="width: 80px;">ID</th>
                                        <th>Category Details</th>
                                        <th>Sub-Category Name</th>
                                        <th class="text-right">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% subcategory.forEach((item, i) => { %>
                                        <tr>
                                            <td class="font-weight-bold" style="color: #95aac9;">
                                                #<%= i + 1 %>
                                            </td>
                                            
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="img-container mr-3">
                                                        <img src="<%= item.categoryId.categoryImage %>" alt="cat">
                                                    </div>
                                                    <div>
                                                        <span class="cat-badge">
                                                            <%= item.categoryId.categoryName %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="font-weight-600" style="color: #12263f;">
                                                <%= item.subCategoryName %>
                                            </td>

                                            <td class="text-right">
                                                <a href="/subcategory/edit-subcategory/<%= item.id %>" 
                                                   class="btn btn-action btn-edit mr-2" 
                                                   title="Edit">
                                                    <i class="fas fa-pencil-alt" style="font-size: 12px;"></i>
                                                </a>
                                                <a href="/subcategory/delete-subcategory/<%= item.id %>" 
                                                   class="btn btn-action btn-delete" 
                                                   title="Delete"
                                                   onclick="return confirm('Are you sure you want to delete this?')">
                                                    <i class="fas fa-trash" style="font-size: 12px;"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div> </div>
        </div>
    </div>
</div>

<%- include('../footer')%>
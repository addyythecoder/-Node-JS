<%- include('../header')%>

<div class="page-wrapper">

  <div class="content-area">

    <!-- HEADER -->
    <div class="top-bar">
      <div>
        <h2>Add Sub Category</h2>
        <p>Create a nested category</p>
      </div>

      <a href="/subcategory/view-subcategory" class="back-btn">
        ← View Sub Categories
      </a>
    </div>

    <!-- CARD -->
    <div class="form-card">

      <form action="/subcategory/add-subcategory" method="post" class="modern-form">

        <!-- CATEGORY -->
        <div class="field">
          <select name="categoryId" required>
            <option value="" disabled selected></option>
            <% category.forEach(cat=>{ %>
              <option value="<%= cat.id %>"><%= cat.categoryName %></option>
            <% }) %>
          </select>
          <label>Select Parent Category</label>
        </div>

        <!-- NAME -->
        <div class="field">
          <input type="text" name="subCategoryName" required>
          <label>Sub Category Name</label>
        </div>

        <!-- BUTTON -->
        <button class="submit-btn">
          Save Sub Category
        </button>

      </form>

    </div>

  </div>
</div>

<style>

/* PAGE */
.page-wrapper{
  background:#f6f8fb !important;
}

.content-area{
  padding:40px;
  max-width:650px;
}

/* TOP BAR */
.top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.top-bar h2{ font-weight:700; }
.top-bar p{ color:#6b7280; }

.back-btn{
  text-decoration:none;
  background:#e5e7eb;
  padding:10px 14px;
  border-radius:8px;
  color:#374151;
}

/* CARD */
.form-card{
  background:white;
  padding:35px;
  border-radius:16px;
  box-shadow:0 20px 40px rgba(0,0,0,0.05);
}

/* FORM */
.modern-form{
  display:flex;
  flex-direction:column;
  gap:25px;
}

/* FLOATING FIELDS */
.field{
  position:relative;
}

.field input,
.field select{
  width:100%;
  padding:16px;
  border-radius:10px;
  border:1px solid #e5e7eb;
  background:#fafafa;
  outline:none;
  appearance:none;
}

.field label{
  position:absolute;
  left:14px;
  top:16px;
  font-size:14px;
  color:#9ca3af;
  pointer-events:none;
  background:white;
  padding:0 5px;
  transition:0.2s;
}

.field input:focus,
.field select:focus{
  border-color:#2563eb;
  background:white;
}

.field input:focus+label,
.field input:valid+label,
.field select:focus+label,
.field select:valid+label{
  top:-8px;
  font-size:12px;
  color:#2563eb;
}

/* BUTTON */
.submit-btn{
  padding:16px;
  border:none;
  border-radius:12px;
  font-size:16px;
  font-weight:600;
  cursor:pointer;
  background:#2563eb;
  color:white;
}

.submit-btn:hover{
  background:#1d4ed8;
}

</style>

<%- include('../footer')%>

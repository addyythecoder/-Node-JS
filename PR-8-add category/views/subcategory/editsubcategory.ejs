<%- include('../header')%>

<style>
    .page-wrapper {
        background: #f4f6f9; /* Subtle light grey background */
        min-height: 100vh;
        padding-bottom: 50px;
    }

    .form-card {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .form-header {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        padding: 25px;
        color: white;
        text-align: center;
    }

    .form-header h4 {
        margin: 0;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 1.1rem;
    }

    .card-body-custom {
        padding: 40px;
    }

    .label-custom {
        font-weight: 600;
        color: #4e5e7a;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .form-control-custom {
        border: 2px solid #e3e6f0;
        border-radius: 10px;
        padding: 12px 15px;
        height: auto;
        transition: all 0.3s ease;
    }

    .form-control-custom:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.1);
        background-color: #fff;
    }

    .btn-submit-custom {
        background: #4e73df;
        border: none;
        padding: 12px 40px;
        border-radius: 10px;
        font-weight: 700;
        color: white;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(78, 115, 223, 0.3);
    }

    .btn-submit-custom:hover {
        background: #2e59d9;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(78, 115, 223, 0.4);
    }

    .back-link {
        color: #858796;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin-bottom: 20px;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: #4e73df;
    }

    .input-group-text {
        background-color: #f8f9fc;
        border: 2px solid #e3e6f0;
        border-right: none;
        border-radius: 10px 0 0 10px;
    }

    .has-icon .form-control-custom {
        border-left: none;
        border-radius: 0 10px 10px 0;
    }
</style>

<div class="page-wrapper">
    <div class="container-fluid">
        <div class="row d-flex justify-content-center pt-5">
            <div class="col-md-5">
                
                <a href="/subcategory/view-subcategory" class="back-link">
                    <i class="mdi mdi-arrow-left mr-1"></i> Back to Sub-Categories
                </a>

                <div class="card form-card">
                    <div class="form-header">
                        <h4><i class="mdi mdi-layers mr-2"></i>Edit Sub-Category</h4>
                    </div>

                    <form action="/subcategory/update-subcategory/<%= subcategory.id %>" method="post">
                        <div class="card-body card-body-custom">
                            
                            <div class="form-group mb-4">
                                <label class="label-custom">Parent Category</label>
                                <div class="input-group has-icon">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="mdi mdi-format-list-bulleted"></i></span>
                                    </div>
                                    <select name="categoryId" class="form-control form-control-custom shadow-none">
                                        <option value="">Select Category</option>
                                        <% category.forEach((category)=>{ %>
                                            <option value="<%= category.id %>" <%= category.id == subcategory.categoryId ? 'selected' : '' %>>
                                                <%= category.categoryName %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label class="label-custom">Sub-Category Name</label>
                                <div class="input-group has-icon">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="mdi mdi-pencil-box-outline"></i></span>
                                    </div>
                                    <input type="text" 
                                           class="form-control form-control-custom shadow-none" 
                                           name="subCategoryName" 
                                           placeholder="Enter sub-category name"
                                           value="<%= subcategory.subCategoryName %>">
                                </div>
                                <small class="text-muted mt-2 d-block">Ensure the name is unique and descriptive.</small>
                            </div>

                            <div class="text-center mt-5">
                                <button type="submit" class="btn btn-submit-custom px-5">
                                    SAVE CHANGES
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
                
                <p class="text-center mt-4 text-muted" style="font-size: 0.8rem;">
                    Last updated: <%= new Date().toLocaleDateString() %>
                </p>

            </div>
        </div>
    </div>
</div>

<%- include('../footer')%>
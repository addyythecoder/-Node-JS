<%- include('../header') %>

<div class="page-wrapper">
  <div class="content-area">

    <!-- TOP BAR -->
    <div class="top-bar">
      <div>
        <h2>Products</h2>
        <p>Manage your product catalog</p>
      </div>

      <div class="top-actions">
        <span class="count"><%= products.length %> Products</span>

        <a href="/product/add-product" class="add-btn">
          + Add Product
        </a>
      </div>
    </div>

    <% if(products.length===0){ %>
      <div class="empty">
        <h3>No Products Found</h3>
        <p>Add your first product to get started</p>
      </div>
    <% } %>

    <!-- GRID -->
    <div class="product-grid">

      <% products.forEach(item=>{ %>

      <div class="product-card">

        <img src="<%= item.productImage %>" class="product-img">

        <div class="p-body">

          <div class="p-top">
            <strong><%= item.productName %></strong>
            <span class="price">₹<%= item.productPrice %></span>
          </div>

          <span class="brand"><%= item.ProductBrand %></span>

          <p class="desc"><%= item.productDes %></p>

          <div class="p-footer">
            <span class="pid">#<%= item.id.toString().slice(-5) %></span>

            <div class="actions">
              <a href="/product/edit-product/<%= item.id %>" class="edit">Edit</a>
              <a href="/product/delete-product/<%= item.id %>"
                 onclick="return confirm('Delete this product?')"
                 class="delete">
                 Delete
              </a>
            </div>
          </div>

        </div>

      </div>

      <% }) %>

    </div>

  </div>
</div>

<style>

/* PAGE */
.page-wrapper{
  background:#f6f8fb !important;
}

.content-area{
  padding:40px;
}

/* TOP BAR */
.top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.top-bar h2{ font-weight:700; }
.top-bar p{ color:#6b7280; }

.top-actions{
  display:flex;
  gap:15px;
  align-items:center;
}

.count{
  background:#eef2ff;
  color:#2563eb;
  padding:6px 12px;
  border-radius:20px;
  font-size:13px;
}

.add-btn{
  background:#2563eb;
  color:white;
  padding:12px 18px;
  border-radius:10px;
  text-decoration:none;
  font-weight:600;
}

.add-btn:hover{
  background:#1d4ed8;
  color:white;
}

/* EMPTY */
.empty{
  text-align:center;
  padding:60px;
  color:#9ca3af;
}

/* GRID */
.product-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
  gap:25px;
}

/* CARD */
.product-card{
  background:white;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 15px 30px rgba(0,0,0,0.05);
  display:flex;
  flex-direction:column;
}

/* IMAGE */
.product-img{
  width:100%;
  height:180px;
  object-fit:cover;
}

/* BODY */
.p-body{
  padding:18px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

/* TOP */
.p-top{
  display:flex;
  justify-content:space-between;
}

.price{
  color:#2563eb;
  font-weight:700;
}

/* BRAND */
.brand{
  font-size:12px;
  color:#6b7280;
}

/* DESC */
.desc{
  font-size:13px;
  color:#6b7280;
  line-height:1.4;
  height:38px;
  overflow:hidden;
}

/* FOOTER */
.p-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:auto;
}

.pid{
  font-size:12px;
  color:#9ca3af;
}

/* ACTIONS */
.actions{
  display:flex;
  gap:10px;
}

.actions a{
  text-decoration:none;
  font-size:13px;
  font-weight:600;
}

.edit{ color:#2563eb; }
.delete{ color:#dc2626; }

</style>

<%- include('../footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title><%= product.productName %> | Apna Store</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>

:root{
  --accent:#2563eb;
  --text:#111827;
  --muted:#6b7280;
  --border:#e5e7eb;
  --bg:#f9fafb;
}

body{
  font-family:'Plus Jakarta Sans',sans-serif;
  background:var(--bg);
  margin:0;
  color:var(--text);
}

/* HEADER */
header{
  background:white;
  padding:18px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
}

.logo{
  font-weight:800;
  font-size:20px;
  text-decoration:none;
  color:var(--text);
}

.logo span{ color:var(--accent); }

.back{
  text-decoration:none;
  color:var(--muted);
  font-weight:600;
  font-size:14px;
}

/* LAYOUT */
.wrapper{
  max-width:1100px;
  margin:50px auto;
  padding:0 20px;
}

.product-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
}

/* IMAGE */
.img-box{
  background:white;
  border-radius:18px;
  padding:40px;
  display:flex;
  justify-content:center;
  align-items:center;
  border:1px solid var(--border);
}

.img-box img{
  max-width:100%;
  max-height:420px;
  object-fit:contain;
}

/* INFO */
.category{
  color:var(--accent);
  font-weight:700;
  font-size:13px;
  text-transform:uppercase;
  letter-spacing:1px;
}

.title{
  font-size:34px;
  font-weight:800;
  margin:10px 0;
}

.price{
  font-size:28px;
  font-weight:800;
  margin:20px 0;
}

/* DESC */
.desc{
  color:var(--muted);
  line-height:1.7;
  font-size:15px;
}

/* CTA */
.cta{
  display:flex;
  gap:15px;
  margin-top:30px;
}

.btn-main{
  padding:14px 22px;
  border-radius:10px;
  font-weight:700;
  font-size:15px;
}

.btn-outline-dark{
  border:2px solid #111;
}

/* BADGES */
.meta{
  margin-top:30px;
  display:flex;
  gap:20px;
  font-size:13px;
  color:var(--muted);
}

/* FOOTER */
footer{
  margin-top:80px;
  padding:40px;
  text-align:center;
  border-top:1px solid var(--border);
  background:white;
  color:var(--muted);
}

@media(max-width:900px){
  .product-layout{
    grid-template-columns:1fr;
  }
}

</style>
</head>

<body>

<header>
  <a href="/web" class="logo">Apna <span>Store</span></a>
  <a href="/web" class="back">← Back</a>
</header>

<div class="wrapper">

  <div class="product-layout">

    <!-- IMAGE -->
    <div class="img-box">
      <img src="<%= product.productImage %>" alt="<%= product.productName %>">
    </div>

    <!-- INFO -->
    <div>
      <div class="category"><%= product.categoryId.categoryName %></div>

      <div class="title"><%= product.productName %></div>

      <div class="price">₹<%= product.productPrice %></div>

      <p class="desc">
        <%= product.productDescription %>
      </p>

      <!-- CTA -->
      <div class="cta">
        <form action="/web/addtocart/<%= product._id %>" method="post">
          <button class="btn btn-outline-dark btn-main">
            Add to Cart
          </button>
        </form>

        <button class="btn btn-primary btn-main">
          Buy Now
        </button>
      </div>

      <!-- META -->
      <div class="meta">
        <span>✅ In Stock</span>
        <span>🚚 Free Shipping</span>
        <span>🛡️ Warranty</span>
      </div>

    </div>

  </div>

</div>

<footer>
  © 2026 Apna Store
</footer>

</body>
</html>

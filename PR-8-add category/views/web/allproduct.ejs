<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Apna Store</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>

:root{
  --accent:#2563eb;
  --bg:#f6f8fb;
}

body{
  font-family:'Plus Jakarta Sans',sans-serif;
  background:var(--bg);
  margin:0;
}

/* NAV */
header{
  background:white;
  padding:15px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eee;
  position:sticky;
  top:0;
  z-index:100;
}

.logo{
  font-weight:800;
  font-size:20px;
}

.logo span{ color:var(--accent); }

.search{
  width:350px;
}

.search input{
  width:100%;
  padding:10px 14px;
  border-radius:8px;
  border:1px solid #e5e7eb;
}

/* CATEGORY */
.category-nav{
  display:flex;
  gap:25px;
  padding:12px 40px;
  background:white;
  border-bottom:1px solid #eee;
  overflow:auto;
}

.cat-item{
  font-size:14px;
  color:#6b7280;
  cursor:pointer;
}

.cat-item:hover{
  color:var(--accent);
}

/* PRODUCTS */
.product-section{
  padding:40px;
}

.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:25px;
}

.product-card{
  background:white;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 10px 25px rgba(0,0,0,0.05);
  display:flex;
  flex-direction:column;
}

.product-card img{
  width:100%;
  height:180px;
  object-fit:cover;
}

.p-body{
  padding:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.p-name{
  font-weight:700;
}

.p-price{
  color:var(--accent);
  font-weight:700;
}

.btn-row{
  display:flex;
  gap:10px;
  margin-top:auto;
}

.btn-soft{
  flex:1;
  padding:10px;
  border-radius:8px;
  text-align:center;
  font-size:13px;
  font-weight:600;
  text-decoration:none;
}

.btn-view{
  background:#f3f4f6;
  color:#374151;
}

.btn-add{
  background:var(--accent);
  color:white;
  border:none;
}

/* FOOTER */
footer{
  background:white;
  padding:40px;
  border-top:1px solid #eee;
  margin-top:60px;
}

</style>
</head>

<body>

<header>
  <div class="logo">Apna <span>Store</span></div>

  <div class="search">
    <input id="searchInput" placeholder="Search products...">
  </div>

  <button class="btn btn-dark" data-bs-toggle="offcanvas" data-bs-target="#cartCanvas">
    Cart (<%= cartCount %>)
  </button>
</header>

<div class="category-nav">
  <% category.forEach(cat=>{ %>
    <div class="cat-item"><%= cat.categoryName %></div>
  <% }) %>
</div>

<div class="product-section">
  <h4 class="mb-4 fw-bold">Products</h4>

  <div class="products-grid">

  <% product.forEach(p=>{ %>
    <div class="product-card">
      <img src="<%= p.productImage %>">

      <div class="p-body">
        <div class="p-name product-name"><%= p.productName %></div>
        <div class="p-price">₹<%= p.productPrice %></div>

        <div class="btn-row">
          <a href="/web/singleview/<%= p.id %>" class="btn-soft btn-view">View</a>

          <form action="/web/addtocart/<%= p._id %>" method="post" style="flex:1;">
            <button class="btn-soft btn-add w-100">Add</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>

  </div>
</div>

<footer class="text-center text-muted">
  © 2026 Apna Store
</footer>

<script>

/* SEARCH */
document.getElementById("searchInput").addEventListener("keyup",function(){
  let val=this.value.toLowerCase();

  document.querySelectorAll(".product-card").forEach(card=>{
    let name=card.querySelector(".product-name").innerText.toLowerCase();
    card.style.display=name.includes(val)?"flex":"none";
  });
});

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

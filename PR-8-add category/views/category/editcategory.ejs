<%- include('../header')%>

<div class="page-wrapper">

  <div class="content-area">

    <!-- HEADER -->
    <div class="top-bar">
      <div>
        <h2>Edit Category</h2>
        <p>Update your category details</p>
      </div>

      <a href="/category/view-categories" class="back-btn">
        ← Back
      </a>
    </div>

    <!-- FORM CARD -->
    <div class="form-card">

      <form action="/category/update-category/<%= category.id %>" 
            method="post" 
            enctype="multipart/form-data"
            class="modern-form">

        <!-- IMAGE PREVIEW -->
        <div>
          <p class="label-title">Category Image</p>

          <label class="upload-box">
            <input type="file" name="categoryImage" id="file-input" hidden>

            <div id="uploadContent">
              <img src="<%= category.categoryImage %>" id="main-preview">
              <span class="change-text">Click to change image</span>
            </div>
          </label>
        </div>

        <!-- NAME -->
        <div class="field">
          <input type="text" 
                 name="categoryName" 
                 value="<%= category.categoryName %>" 
                 required>
          <label>Category Name</label>
        </div>

        <!-- INFO BOX -->
        <div class="info-box">
          Category ID: <%= category.id %>
        </div>

        <!-- BUTTONS -->
        <div class="btn-row">
          <button class="submit-btn">Save Changes</button>
          <a href="/category/view-categories" class="cancel-btn">Cancel</a>
        </div>

      </form>

    </div>

  </div>
</div>

<style>

/* PAGE */
.page-wrapper{
  background:#f6f8fb !important;
}

.content-area{
  padding:40px;
  max-width:700px;
}

/* HEADER */
.top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.top-bar h2{
  font-weight:700;
}

.top-bar p{
  color:#6b7280;
}

.back-btn{
  text-decoration:none;
  background:#e5e7eb;
  padding:10px 14px;
  border-radius:8px;
  color:#374151;
}

/* CARD */
.form-card{
  background:white;
  padding:35px;
  border-radius:16px;
  box-shadow:0 20px 40px rgba(0,0,0,0.05);
}

/* FORM */
.modern-form{
  display:flex;
  flex-direction:column;
  gap:25px;
}

/* FLOATING FIELD */
.field{
  position:relative;
}

.field input{
  width:100%;
  padding:16px;
  border-radius:10px;
  border:1px solid #e5e7eb;
  background:#fafafa;
  outline:none;
}

.field label{
  position:absolute;
  left:14px;
  top:16px;
  font-size:14px;
  color:#9ca3af;
  pointer-events:none;
  transition:0.2s;
  background:white;
  padding:0 5px;
}

.field input:focus{
  border-color:#2563eb;
  background:white;
}

.field input:focus + label,
.field input:valid + label{
  top:-8px;
  font-size:12px;
  color:#2563eb;
}

/* TITLE */
.label-title{
  font-weight:600;
  color:#374151;
}

/* UPLOAD */
.upload-box{
  border:2px dashed #d1d5db;
  border-radius:12px;
  padding:20px;
  text-align:center;
  cursor:pointer;
  display:block;
  background:#fafafa;
}

.upload-box img{
  width:100%;
  border-radius:12px;
  max-height:200px;
  object-fit:cover;
}

.change-text{
  display:block;
  margin-top:10px;
  color:#2563eb;
  font-size:14px;
}

/* INFO BOX */
.info-box{
  background:#eef2ff;
  padding:12px;
  border-radius:10px;
  color:#2563eb;
  font-weight:600;
}

/* BUTTONS */
.btn-row{
  display:flex;
  gap:15px;
}

.submit-btn{
  flex:1;
  padding:16px;
  border:none;
  border-radius:12px;
  font-size:16px;
  font-weight:600;
  cursor:pointer;
  background:#2563eb;
  color:white;
}

.submit-btn:hover{
  background:#1d4ed8;
}

.cancel-btn{
  flex:1;
  text-align:center;
  padding:16px;
  border-radius:12px;
  text-decoration:none;
  background:#f3f4f6;
  color:#374151;
}

</style>

<script>

const fileInput = document.getElementById("file-input");
const preview = document.getElementById("main-preview");

fileInput.onchange = () => {
  const file = fileInput.files[0];
  if(file){
    preview.src = URL.createObjectURL(file);
  }
};

</script>

<%- include('../footer')%>

<%- include('../header') %>

<style>
    body {
        background: #0e1015;
        color: #e4e6eb;
    }

    .profile-card {
        background: rgba(28, 31, 38, 0.9);
        backdrop-filter: blur(14px);
        border-radius: 22px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.6);
        border: 1px solid #2b2f3a;
        overflow: hidden;
    }

    .profile-left {
        background: linear-gradient(160deg, #151823, #0f121a);
        text-align: center;
        padding: 40px 20px;
    }

    .profile-img {
        width: 180px;
        height: 180px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #2b2f3a;
        box-shadow: 0 0 25px rgba(79,195,247,0.4);
        margin-bottom: 15px;
    }

    .badge-role {
        background: linear-gradient(45deg,#00c6ff,#0072ff);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 13px;
    }

    .detail-label {
        color: #9aa0ac;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .detail-value {
        color: #fff;
        margin-bottom: 12px;
    }

    .btn-back {
        border-radius: 50px;
        padding: 8px 20px;
    }
</style>

<div class="container mt-5">

    <div class="card profile-card">
        <div class="row no-gutters">

            <!-- Left -->
            <div class="col-md-4 profile-left">
                <img src="<%= blog.image %>" class="profile-img">

                <h4 class="text-white mb-1"><%= blog.title %></h4>

                <span class="badge badge-role mb-2">
                    Blog Post
                </span>
                <br>

                <span class="badge badge-success mt-2 d-inline-block">
                    Published
                </span>
            </div>

            <!-- Right -->
            <div class="col-md-8 p-4">
                <h5 class="text-white mb-4">Blog Details</h5>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="detail-label">Author</div>
                        <div class="detail-value"><%= blog.author %></div>
                    </div>

                    <div class="col-sm-6">
                        <div class="detail-label">Created At</div>
                        <div class="detail-value"><%= blog.createdAt %></div>
                    </div>

                    <div class="col-12">
                        <div class="detail-label">Description</div>
                        <div class="detail-value">
                            <%= blog.description %>
                        </div>
                    </div>
                </div>

                <hr style="border-color:#2b2f3a">

                <a href="/blog/view-blog" class="btn btn-outline-secondary btn-back">
                    ⬅ Back to Blogs
                </a>
            </div>

        </div>
    </div>

</div>

<%- include('../footer') %>

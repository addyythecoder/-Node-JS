<%- include('../header') %>

<style>
    body {
        background: #0e1015;
        color: #e4e6eb;
    }

    .blog-search {
        border-radius: 50px;
        padding: 12px 20px;
        background: #1c1f26;
        color: #fff;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        border: 1px solid #2b2f3a;
    }

    .blog-search::placeholder {
        color: #9aa0ac;
    }

    .blog-card {
        transition: all 0.35s ease;
    }

    .blog-card:hover {
        transform: translateY(-10px);
    }

    .blog-card-inner {
        border-radius: 22px;
        background: rgba(28, 31, 38, 0.9);
        backdrop-filter: blur(14px);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
        border: 1px solid #2b2f3a;
        overflow: hidden;
        position: relative;
    }

    .blog-card-inner::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 22px;
        background: radial-gradient(circle at top, rgba(79, 195, 247, 0.08), transparent 60%);
        pointer-events: none;
    }

    .blog-img {
        height: 200px;
        object-fit: cover;
        width: 100%;
        border-bottom: 1px solid #2b2f3a;
    }

    .status-pill {
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-publish {
        background: rgba(15, 157, 88, 0.15);
        color: #34e89e;
        border: 1px solid #34e89e;
    }

    .status-draft {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid #ffc107;
    }

    .action-btn {
        border-radius: 50px;
        font-size: 13px;
        padding: 6px 14px;
    }

    hr {
        border-color: #2b2f3a;
    }

    .page-wrapper {
        min-height: 100vh;
        padding-bottom: 60px;
    }
</style>

<div class="page-wrapper">

    <div class="container pt-4">

        <!-- Title -->
        <div class="text-center mb-4">
            <h2 class="text-white font-weight-bold">Blogs</h2>
            <p class="text-muted">Manage all blog posts</p>

            <input type="text" id="blogSearch"
                class="form-control blog-search mt-3 w-50 mx-auto"
                placeholder="🔍 Search by title or author">
        </div>

        <div class="row" id="blogList">

            <% blogs.forEach(blo => { %>
            <div class="col-lg-4 col-md-6 mb-4 blog-card">

                <div class="blog-card-inner">

                    <img src="<%= blo.image %>" class="blog-img">

                    <div class="p-4 text-center">

                        <h5 class="mb-1 text-white font-weight-bold">
                            <%= blo.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            ✍️ <%= blo.author %>
                        </p>

                        <span class="status-pill 
                            <%= blo.status === 'publish' ? 'status-publish' : 'status-draft' %>">
                            <%= blo.status.toUpperCase() %>
                        </span>

                        <div class="d-flex justify-content-center gap-2 mt-4">
                            <a href="/blog/single-view/<%= blo.id %>"
                                class="btn btn-outline-info action-btn mr-2">
                                View
                            </a>

                            <a href="/blog/edit-blog/<%= blo.id %>"
                                class="btn btn-outline-primary action-btn mr-2">
                                Edit
                            </a>

                            <a href="/blog/delete-blog/<%= blo.id %>"
                                class="btn btn-outline-danger action-btn">
                                Delete
                            </a>
                        </div>

                    </div>
                </div>
            </div>
            <% }) %>

        </div>
    </div>
</div>

<script>
    document.getElementById("blogSearch").addEventListener("keyup", function () {
        let value = this.value.toLowerCase();
        document.querySelectorAll(".blog-card").forEach(card => {
            card.style.display = card.innerText.toLowerCase().includes(value)
                ? "block"
                : "none";
        });
    });
</script>

<%- include('../footer') %>

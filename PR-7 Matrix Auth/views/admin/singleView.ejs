<%- include('../header') %>

<style>
    body {
        background: #0e1015;
        color: #e4e6eb;
    }

    .profile-card {
        background: rgba(28, 31, 38, 0.9);
        backdrop-filter: blur(14px);
        border-radius: 22px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.6);
        border: 1px solid #2b2f3a;
        overflow: hidden;
    }

    .profile-left {
        background: linear-gradient(160deg, #151823, #0f121a);
        text-align: center;
        padding: 40px 20px;
    }

    .profile-img {
        width: 180px;
        height: 180px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #2b2f3a;
        box-shadow: 0 0 25px rgba(79,195,247,0.4);
        margin-bottom: 15px;
    }

    .badge-role {
        background: linear-gradient(45deg,#00c6ff,#0072ff);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 13px;
    }

    .status-active {
        background: rgba(15, 157, 88, 0.15);
        color: #34e89e;
        border: 1px solid #34e89e;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 12px;
    }

    .status-inactive {
        background: rgba(217, 48, 37, 0.15);
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 12px;
    }

    .detail-label {
        color: #9aa0ac;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .detail-value {
        color: #fff;
        margin-bottom: 12px;
    }

    .btn-back {
        border-radius: 50px;
        padding: 8px 20px;
    }
</style>

<div class="container mt-5">

    <div class="card profile-card">
        <div class="row no-gutters">

            <!-- Left -->
            <div class="col-md-4 profile-left">
                <img src="<%= admin.image %>" class="profile-img">

                <h4 class="text-white mb-1"><%= admin.name %></h4>

                <span class="badge badge-role mb-2">
                    <%= admin.role %>
                </span>
                <br>

                <span class="<%= admin.status === 'active' ? 'status-active' : 'status-inactive' %> mt-2 d-inline-block">
                    <%= admin.status.toUpperCase() %>
                </span>
            </div>

            <!-- Right -->
            <div class="col-md-8 p-4">
                <h5 class="text-white mb-4">Admin Details</h5>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="detail-label">Email</div>
                        <div class="detail-value"><%= admin.email %></div>
                    </div>

                    <div class="col-sm-6">
                        <div class="detail-label">Phone</div>
                        <div class="detail-value"><%= admin.phone %></div>
                    </div>

                    <div class="col-sm-6">
                        <div class="detail-label">Gender</div>
                        <div class="detail-value"><%= admin.gender %></div>
                    </div>

                    <div class="col-sm-6">
                        <div class="detail-label">Created At</div>
                        <div class="detail-value"><%= admin.createdAt %></div>
                    </div>

                    <div class="col-12">
                        <div class="detail-label">Address</div>
                        <div class="detail-value"><%= admin.address %></div>
                    </div>
                </div>

                <hr style="border-color:#2b2f3a">

                <a href="/admin/view-admin" class="btn btn-outline-secondary btn-back">
                    ⬅ Back to Admins
                </a>
            </div>

        </div>
    </div>

</div>

<%- include('../footer') %>
